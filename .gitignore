__pycache__/
*.py[cod]

# Third-party, pip-installed: `pip install --target vendor anthropic==0.109.2`
# rebuilds it. 28 MB of someone else's code does not belong in this history —
# and the provider layer in rpc_server/ uses stdlib urllib, so nothing needs it.
vendor/

# Regenerated on every external-CLI launch to match the running session. The
# per-CLI names are the same text under whatever filename that CLI auto-loads
# from its cwd (see _CONVENTION_FILES in console.py).
AGENT_BRIEFING.md
CLAUDE.md
AGENTS.md
GEMINI.md

# Test documents the assistant left behind at the addon root.
*.FCStd
*.FCBak

# Transcripts and verdicts from test_bearing_run.py. The numbers get quoted in
# commit messages and issues; the raw logs are per-machine, per-model noise.
*.log
test_bearing_exit

# Symlinks out to personal paths, meaningless in a clone:
#   dimensions.txt                -> ~/Documents/...
#   FreeCAD-Documentation-Project -> ~/github/FreeCAD-Documentation-Project
# The wiki mirror is what search_wiki reads; clone it yourself and symlink it.
dimensions.txt
FreeCAD-Documentation-Project
.gstack/
suite_logs*/
